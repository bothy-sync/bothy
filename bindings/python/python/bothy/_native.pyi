# Type stubs for the native module. Use the wrappers in `bothy` and `bothy.auth`.
from typing import Any, Callable, Dict, List, Optional, Tuple, Union

__version__: str

class BothyError(Exception): ...
class OfflineError(BothyError): ...
class AuthRequiredError(BothyError): ...
class RateLimitedError(BothyError): ...
class QuotaExceededError(BothyError): ...
class RemoteInconsistentError(BothyError): ...
class FormatTooNewError(BothyError): ...
class SchemaTooNewError(BothyError): ...
class WrongPasswordError(BothyError): ...
class KeyRequiredError(BothyError): ...
class CorruptError(BothyError): ...
class DatabaseLockedError(BothyError): ...
class InvalidInputError(BothyError): ...
class InternalError(BothyError): ...

class Grant:
    @property
    def scopes(self) -> List[str]: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> Optional["Grant"]: ...

class TokenProvider:
    def __init__(self, client_file: Optional[str], grant: Grant) -> None: ...
    def access_token(self) -> str: ...

_Tokens = Union[TokenProvider, Callable[[bool], str]]

class Remote:
    @staticmethod
    def folder(path: str) -> "Remote": ...
    @staticmethod
    def drive_appdata(tokens: _Tokens) -> "Remote": ...
    @staticmethod
    def drive_folder(name: str, tokens: _Tokens) -> "Remote": ...

class Changes:
    def next(self, timeout: Optional[float] = None) -> Optional[Tuple[str, str, bool]]: ...

class Database:
    @staticmethod
    def open(path: str, app_id: str, remote: Remote, *, encrypt: bool = False,
             password: Optional[str] = None, key: Optional[bytes] = None,
             device_name: Optional[str] = None,
             conflict_log_limit: Optional[int] = 1000, p2p: bool = False,
             stun: Optional[List[str]] = None,
             p2p_host: Optional[str] = None) -> "Database": ...
    @property
    def device_id(self) -> str: ...
    def db_id(self) -> Optional[str]: ...
    def init(self) -> str: ...
    def join(self, db_id: str) -> Dict[str, Any]: ...
    def init_or_join(self) -> str: ...
    def sync(self) -> Dict[str, Any]: ...
    def put(self, collection: str, id: str, json: str) -> bool: ...
    def patch(self, collection: str, id: str, json: str, unset: List[str]) -> bool: ...
    def get(self, collection: str, id: str) -> Optional[str]: ...
    def list(self, collection: str, limit: int = 100,
             after: Optional[str] = None) -> List[Tuple[str, str]]: ...
    def delete(self, collection: str, id: str) -> bool: ...
    def collections(self) -> List[str]: ...
    def changes(self) -> Changes: ...
    def start_auto_sync(self, debounce: float = 2.0, poll_interval: float = 300.0) -> None: ...
    def auto_sync_status(self) -> Union[None, Dict[str, Any], BothyError]: ...
    def stop_auto_sync(self) -> None: ...
    def p2p_status(self) -> Dict[str, Any]: ...
    def status(self) -> Dict[str, Any]: ...
    def conflicts(self, since_ms: Optional[int] = None) -> List[Dict[str, Any]]: ...
    def clear_conflicts(self) -> int: ...
    def is_encrypted(self) -> bool: ...
    def is_locked(self) -> bool: ...
    def unlock(self, password: str) -> None: ...
    def unlock_with_key(self, key: bytes) -> None: ...
    def lock(self) -> None: ...
    def export_key(self) -> bytes: ...
    def change_password(self, old: str, new: str) -> None: ...
    def close(self) -> None: ...

def device_login(client_file: Optional[str], show: Callable[[str, str], None]) -> Grant: ...
def loopback_login(client_file: Optional[str], show: Callable[[str], None],
                   scopes: Optional[List[str]] = None) -> Grant: ...
